{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPilot",
  "version": "0.1.13",
  "identifier": "com.mcpilot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OUZFNTUwOUVBMkQ1MzQKUldRMDFhS2VVT1dmeEhZNnhTYXRtc0I0V1g0MkZNR3BXMzh1VVExOGduMEJOdXRKbkpKMEUxc2cK",
      "endpoints": [
        "https://github.com/diduweiwu/mcp-polit/releases/latest/download/latest.json"
      ]
    }
  }
}
